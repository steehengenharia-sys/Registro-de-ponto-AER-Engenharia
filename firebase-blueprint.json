{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin_master", "admin", "funcionario"] },
        "role_name": { "type": "string" },
        "phone": { "type": "string" },
        "cargo": { "type": "string" },
        "telefone": { "type": "string" },
        "valor_diaria": { "type": "number" },
        "status": { "type": "string", "enum": ["ativo", "inativo"] }
      },
      "required": ["id", "name", "username", "role"]
    },
    "Work": {
      "title": "Work",
      "description": "Construction site or work location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "radius": { "type": "number" }
      },
      "required": ["id", "name", "city", "address"]
    },
    "Point": {
      "title": "Point",
      "description": "Time clock record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "funcionario_id": { "type": "string" },
        "user_name": { "type": "string" },
        "date": { "type": "string" },
        "work_id": { "type": "string" },
        "work_name": { "type": "string" },
        "status": { "type": "string" },
        "entrada1": { "type": "object" },
        "saida1": { "type": "object" },
        "entrada2": { "type": "object" },
        "saida2": { "type": "object" },
        "total_hours": { "type": "number" },
        "obs": { "type": "string" },
        "editado_manual": { "type": "number" },
        "encerrado": { "type": "boolean" },
        "corrigido_manual": { "type": "boolean" }
      },
      "required": ["id", "user_id", "date"]
    },
    "PointReminderSchedule": {
      "title": "Point Reminder Schedule",
      "description": "Notification settings for a user or company",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "timezone": { "type": "string" },
        "workDays": { "type": "array" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "entryReminder1": { "type": "string" },
        "entryReminder2": { "type": "string" },
        "exitReminder1": { "type": "string" },
        "exitReminder2": { "type": "string" },
        "useCompanyDefault": { "type": "boolean" },
        "employeeUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/works/{workId}": {
      "schema": { "$ref": "#/entities/Work" },
      "description": "Work locations"
    },
    "/points/{pointId}": {
      "schema": { "$ref": "#/entities/Point" },
      "description": "Time clock records"
    },
    "/pointReminderSchedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/PointReminderSchedule" },
      "description": "Notification schedules"
    }
  }
}
