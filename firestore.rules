rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == "steeh.engenharia@gmail.com";
    }

    function isVerified() {
      // Relaxed verification: signed in and (email verified OR is the master admin)
      // For many apps, we can just check if they are signed in.
      return isSignedIn() && (request.auth.token.email_verified == true || isMasterAdmin());
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin_master', 'admin']
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list users to prevent leaking profile data
      allow list: if isAdmin();
      
      // Users can create their own profile on first login (as funcionario)
      allow create: if isOwner(userId) || isAdmin();
      
      // Only admins can update/delete roles and other user data
      allow update, delete: if isAdmin();
    }

    // --- Works Collection ---
    match /works/{workId} {
      // All authenticated users need to read works to select them
      allow read: if isSignedIn();
      
      // Only admins can manage works
      allow create, update, delete: if isAdmin();
    }

    // --- Points Collection ---
    match /points/{pointId} {
      allow get, list: if isAdmin()
        || (
          isSignedIn()
          && (resource == null || resource.data.user_id == request.auth.uid)
        );

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.funcionario_id == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.user_id == request.auth.uid
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.funcionario_id == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // --- Point Reminder Schedules ---
    match /pointReminderSchedules/{scheduleId} {
      // Admins see all, users see company default or their own
      allow read: if isAdmin() || (isSignedIn() && (scheduleId == 'companyDefault' || scheduleId == request.auth.uid));
      
      // Admins manage all, users manage their own
      allow write: if isAdmin() || (isSignedIn() && scheduleId == request.auth.uid);
    }

    // --- Point Notification Devices ---
    match /pointNotificationDevices/{deviceDocId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
